# ==============================================================================
# Indu Housing - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local and fill in your real credentials:
#   cp .env.example .env.local

# ------------------------------------------------------------------------------
# Zoho Mail SMTP Configuration for Nodemailer (induhousing.com)
# ------------------------------------------------------------------------------
# SMTP server host (for induhousing.com on Zoho India: smtp.zoho.in)
SMTP_HOST=smtp.zoho.in

# SMTP port: 465 (SSL, recommended) or 587 (TLS/STARTTLS)
SMTP_PORT=465

# Your business email address used to authenticate and send enquiries
SMTP_USER=marketing@induhousing.com

# Zoho Mail App Password (generated from Zoho Security > App Passwords)
SMTP_PASS=your-app-password

# ------------------------------------------------------------------------------
# Email Routing
# ------------------------------------------------------------------------------
# The email address that should RECEIVE all website enquiries (defaults to SMTP_USER if omitted)
CONTACT_RECIPIENT_EMAIL=marketing@induhousing.com

# Optional custom "From" header (e.g. "Indu Housing Website" <your-email@gmail.com>)
CONTACT_FROM_EMAIL="Indu Housing Enquiries" <your-email@gmail.com>
